# Copy to deploy/.env and fill in — passed to the backend container via
# env_file in deploy/docker-compose.yml. DATABASE_URL is set by
# docker-compose.yml itself (points at the db service) and doesn't belong here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIM=3072
CORS_ORIGIN_REGEX=chrome-extension://.*|http://localhost(:\d+)?|http://127\.0\.0\.1(:\d+)?
ENV=prod
