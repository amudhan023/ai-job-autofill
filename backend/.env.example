# Copy to .env and fill in. The app boots without these (AI features are stubbed).
#
# Recommended: Anthropic Claude. This is the only provider with native tool
# use, which /ai/fill (filling the fields the rule engine could not match)
# relies on for structured, schema-validated answers. Get a key at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
# Embeddings (used to retrieve your own experience for free-text answers).
# Anthropic has no embeddings API: use Voyage, or Gemini, or leave both blank
# to run without retrieval.
VOYAGE_API_KEY=

# Alternative: Google Gemini for the LLM too (no Anthropic key needed).
# Set GEMINI_API_KEY, and set LLM_PROVIDER=gemini above.
GEMINI_API_KEY=
# LLM model options: gemini-2.0-flash, gemini-1.5-pro, gemini-2.5-pro, gemini-2.5-flash
GEMINI_MODEL=gemini-2.0-flash
# Embedding model (google-genai SDK requires full path: models/<name>)
# Options: models/gemini-embedding-001 (stable), models/gemini-embedding-2 (latest)
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Provider selection (leave blank to auto-detect from whichever keys are set)
# LLM_PROVIDER=anthropic       # or: gemini
# EMBEDDINGS_PROVIDER=voyage   # or: gemini

# Set to 1 to run deterministic fake AI (no keys needed) — used by integration tests.
USE_FAKE_AI=0

# Models (see PLAN.md §3). Defaults baked into settings; override here if needed.
# When using Gemini, GEMINI_MODEL overrides these for all tasks — no per-task
# model vars needed. These are kept for Anthropic compatibility.
RESUME_MODEL=claude-sonnet-5
JD_MODEL=claude-haiku-4-5
QA_MODEL=claude-sonnet-5
COVER_LETTER_MODEL=claude-opus-5
CLASSIFIER_MODEL=claude-haiku-4-5
# Fills the leftover unmatched fields via tool use (/ai/fill).
FILL_MODEL=claude-sonnet-5
EMBEDDING_MODEL=voyage-3.5-lite

# Infra. Default is a zero-infra local SQLite file — no setup needed. Point
# this at a postgresql+psycopg:// URL to opt into Postgres/pgvector (real SQL
# similarity search for the knowledge-base corpus — see deploy/docker-compose.yml
# for a ready-to-run Postgres+pgvector + backend stack).
# DATABASE_URL=postgresql+psycopg://jobfill:jobfill@<ubuntu-host>:5432/jobfill
DATABASE_URL=sqlite:///./data/app.db
REDIS_URL=redis://localhost:6379/0

# pgvector column width — must match the active embeddings provider's output
# dimension (3072 for Gemini's gemini-embedding-001). Changing provider/model
# later requires dropping and recreating the rag_chunks table.
EMBEDDING_DIM=3072

# CORS allowed origins as a REGEX (not a literal). Must match the dynamic
# extension origin chrome-extension://<id>. Default covers the extension + localhost.
CORS_ORIGIN_REGEX=chrome-extension://.*|http://localhost(:\d+)?|http://127\.0\.0\.1(:\d+)?
ENV=dev
